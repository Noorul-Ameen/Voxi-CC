# ── Cloudflare Worker secrets ──────────────────────────────────────────────
# Local dev: copy to `.dev.vars` (never committed). Deployed environments:
# `wrangler secret put <NAME> [--env staging|production]`.

# ElevenLabs private API key (server-side only; used to mint signed voice
# sessions via POST /api/voice/session). NEVER exposed to the browser.
ELEVENLABS_API_KEY=

# Bearer token protecting GET /api/monitoring/status?detail=1
MONITORING_SECRET=

# ── Optional: MAF/Apigee VOX partner API (protected commerce) ──────────────
# Without these, all protected commerce operations (tickets, seats, food,
# payment, booking, refunds) are FAIL-CLOSED and report "unavailable".
VOX_API_KEY=
VOX_CLIENT_SECRET=

# ── Non-secret vars (configured in wrangler.jsonc, listed for reference) ───
# ELEVENLABS_AGENT_ID=      # per-environment ElevenLabs agent id
# VOX_BASE_URL=https://uae.voxcinemas.com
# VOX_PARTNER_API_BASE_URL= # e.g. https://api-prod.maflec.com/vistatickets/vista/v2
# COMMERCE_MODE=demo|production
